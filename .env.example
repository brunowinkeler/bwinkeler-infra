# Version pins for the shared infrastructure images. Copy to `.env`:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never use `latest` in production (ARCHITECTURE.md §8.2).
# Pin a concrete tag before deploying and upgrade PostgreSQL majors only via the
# documented procedure in docs/RUNBOOK.md.

# Caddy 2.x reverse proxy. Pin a concrete patch for production, e.g. 2.8.4.
CADDY_VERSION=2

# PostgreSQL major version. MUST match the applications' major (currently 16,
# see bwinkeler-lists/deploy/compose.dev.yaml). Upgrading the major is a
# documented, backup-first procedure — not a tag bump.
POSTGRES_VERSION=16
