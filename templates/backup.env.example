# Backup job configuration. Install as /etc/bwinkeler/backup.env (mode 0600).
# Used by backup/backup-databases.sh and backup/restore-database.sh.
# NEVER commit real values (ARCHITECTURE.md §17, §20).

# Databases to back up (space-separated). Keep in sync with docs/inventory.md.
BACKUP_DATABASES="lists_db"

# --- Encryption (age) -------------------------------------------------------
# Public recipient(s) used to encrypt each dump. The matching PRIVATE key lives
# OFF the VPS (password manager / offline media). Generate with `age-keygen`.
AGE_RECIPIENTS="age1replace-with-your-public-recipient"

# --- Cloudflare R2 (S3-compatible) via rclone -------------------------------
# Preferred: configure an rclone remote named as R2_REMOTE pointing at R2 with a
# token scoped to this bucket only (write for backup; read for restore).
R2_REMOTE=r2
R2_BUCKET=bwinkeler-backups
R2_PREFIX=postgres

# Alternative to a pre-existing remote: the script can build a temporary rclone
# config from these. Uncomment and set on the host only.
# R2_ACCOUNT_ID=replace
# R2_ACCESS_KEY_ID=replace
# R2_SECRET_ACCESS_KEY=replace
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- Retention (counts) — pruning procedure is in backup/README.md ----------
RETAIN_DAILY=7
RETAIN_WEEKLY=4
RETAIN_MONTHLY=6

# Where the infra compose lives + the postgres service name (pg_dump runs inside
# the running container so no host client is required).
INFRA_DIR=/srv/bwinkeler/infra
POSTGRES_SERVICE=postgres
