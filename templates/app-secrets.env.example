# Template for an application's secret files. For each app, create BOTH:
#   /etc/bwinkeler/apps/<service_id>/runtime.env    (runtime role)
#   /etc/bwinkeler/apps/<service_id>/migration.env  (migrator role)
# mode 0600, root-owned, never in Git (ARCHITECTURE.md §17.2). The runtime file
# must NEVER contain the migrator credential.
#
# The authoritative variable list is the app's SERVICE_MANIFEST and its
# deploy/env/*.example. The shapes below are illustrative.

# ================= runtime.env (used by the api container) =================
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# PUBLIC_ORIGIN=https://<service_id>.bwinkeler.com
# PGHOST=bw-postgres
# PGPORT=5432
# PGDATABASE=<service_id>_db
# PGUSER=<service_id>_runtime
# PGPASSWORD=<runtime-secret>
# SESSION_SECRET=<secret>
# ... other app-specific runtime vars ...

# =============== migration.env (used by the one-shot migrate job) ===========
# NODE_ENV=production
# PGHOST=bw-postgres
# PGPORT=5432
# PGDATABASE=<service_id>_db
# PGUSER=<service_id>_migrator
# PGPASSWORD=<migrator-secret>
