# PostgreSQL superuser bootstrap for the SHARED instance.
# Install on the host as /etc/bwinkeler/infra.env (mode 0600, root-owned).
#
# These values initialize the `bw-postgres-data` volume on FIRST start ONLY.
# Changing them afterwards does NOT alter existing roles — use ALTER ROLE via
# psql instead. NEVER commit real values (ARCHITECTURE.md §17).
POSTGRES_USER=bw_admin
POSTGRES_PASSWORD=replace-with-strong-random-secret
POSTGRES_DB=postgres
